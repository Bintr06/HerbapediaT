# ==============================================================
# HerbaPedia - Comprehensive Git Ignore
# ==============================================================

# --- Python Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
BE/venv/
BE/.venv/
**/venv/
**/.venv/

# --- Python Bytecode & Cache ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Environment Variables & Sensitive Secrets ---
.env
.env.*
*.env
BE/.env
FE/.env
!.env.example
!BE/.env.example

# --- Local Databases & SQLite ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# --- AI & Deep Learning Model Binaries (>100MB Git limit) ---
# Quy tắc chuẩn: Không commit model nặng trực tiếp lên Git
*.h5
*.hdf5
*.keras
*.pth
*.pt
*.onnx
*.tflite
*.safetensors
*.ckpt
*.weights
*.bin
*.pkl
*.pickle
*.joblib
models/*.h5
models/*.pth
models/*.pt
models/*.keras
BE/models/*.h5
BE/models/*.pth
BE/models/*.pt
BE/models/*.keras
# (Tùy chọn: Nếu muốn commit model < 100MB lên Git hoặc qua Git LFS, bỏ comment các dòng sau):
# !BE/models/best_leaf_model.keras
# !BE/models/mobilenet_leaf_model.keras

# --- Logs, Temporary & Debug Files ---
*.log
logs/
*.tmp
*.temp
tmp/
temp/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Text Editor Configuration ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Frontend & Node Packages (nếu có dùng build tools) ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
