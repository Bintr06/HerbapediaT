# ==============================================================
# HerbaPedia Backend - Git Ignore
# ==============================================================

# Virtual Environment
venv/
.venv/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment Variables & Secrets
.env
.env.*
*.env
!.env.example

# Databases
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# AI / Deep Learning Model Weights (>100MB)
*.h5
*.hdf5
*.keras
*.pth
*.pt
*.onnx
*.tflite
*.safetensors
*.bin
*.pkl
models/*.h5
models/*.pth
models/*.pt
models/*.keras
!models/best_leaf_model.keras
!models/mobilenet_leaf_model.keras

# Logs & Temporary Files
*.log
logs/
*.tmp
temp/
tmp/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
